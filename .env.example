# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# JWT
JWT_SECRET=inilah-secret-key-yang-minimal-32-karakter

# App URL
CLIENT_URL=http://localhost:3000

# SMTP (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true untuk port 465 (TLS langsung)
SMTP_SECURE=false
SMTP_USER=tuliskan-email-gmail-anda
SMTP_PASS=tuliskan-app-password-16-karakter
SMTP_FROM="Tixo <tuliskan-email-gmail-anda>"

# Midtrans Snap (Sandbox: Dashboard > Settings > Access Keys)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# Set true hanya jika aplikasi berjalan di belakang reverse proxy
TRUST_PROXY=false

# Node
NODE_ENV=development

# Expo push (opsional, hanya bila Enhanced Push Security aktif)
# EXPO_ACCESS_TOKEN=
