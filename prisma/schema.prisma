generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 
// ENUMS
// 
enum Gender {
  male
  female
  other
}

enum OrganizerStatus {
  pending
  verified
  rejected
  suspended
}

enum EventStatus {
  draft
  pending_review
  published
  rejected
  ongoing
  completed
  cancelled
}

enum TicketTypeStatus {
  active
  sold_out
  inactive
}

enum OrderStatus {
  pending
  paid
  expired
  cancelled
  refunded
}

enum DiscountType {
  percentage
  fixed
}

enum PaymentStatus {
  pending
  settlement
  expired
  failed
  refunded
}

enum TicketStatus {
  issued
  checked_in
  cancelled
  expired
}

enum ScanResult {
  success
  duplicate
  invalid
}

enum NotificationType {
  order
  payment
  event
  system
}

enum AuditAction {
  create
  update
  delete
}

// 
// MASTER DATA
// 
model roles {
  id   BigInt @id @default(autoincrement())
  name String @unique

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  users users[]
}

model countries {
  id BigInt @id @default(autoincrement())

  code String @unique
  name String

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  provinces provinces[]
}

model provinces {
  id BigInt @id @default(autoincrement())

  country_id BigInt
  code       String?
  name       String

  country countries @relation(fields: [country_id], references: [id])

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  cities       cities[]
  userProfiles user_profiles[]

  @@index([country_id])
}

model cities {
  id BigInt @id @default(autoincrement())

  province_id BigInt
  code        String?
  name        String

  province provinces @relation(fields: [province_id], references: [id])

  created_at   DateTime        @default(now())
  updated_at   DateTime?       @updatedAt
  userProfiles user_profiles[]
  venues       venues[]

  @@index([province_id])
}

// 
// AUTH & USERS
// 
model users {
  id        BigInt @id @default(autoincrement())
  public_id String @unique @default(uuid())

  role_id BigInt

  email    String @unique
  password String

  email_verified Boolean @default(false)
  is_active      Boolean @default(true)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  role               roles                 @relation(fields: [role_id], references: [id])
  userProfiles       user_profiles[]
  refreshTokens      refresh_tokens[]
  passwordResets     password_resets[]
  emailVerifications email_verifications[]
  organizers         organizers[]
  carts              carts[]
  orders             orders[]
  voucherUsages      voucher_usages[]
  tickets            tickets[]
  ticketScans        ticket_scans[]
  notifications      notifications[]
  auditLogs          audit_logs[]
  activityLogs       activity_logs[]
  approvedEvents     events[]              @relation("approvedBy")

  @@index([role_id])
  @@index([is_active])
}

model user_profiles {
  id        BigInt @id @default(autoincrement())
  public_id String @unique @default(uuid())

  user_id BigInt @unique

  full_name  String
  phone      String?
  gender     Gender?
  birth_date DateTime?
  avatar     String?

  province_id BigInt?
  city_id     BigInt?

  address String?

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  user     users      @relation(fields: [user_id], references: [id])
  province provinces? @relation(fields: [province_id], references: [id])
  city     cities?    @relation(fields: [city_id], references: [id])

  @@index([province_id])
  @@index([city_id])
}

model refresh_tokens {
  id BigInt @id @default(autoincrement())

  user_id BigInt

  token      String    @unique
  expired_at DateTime
  revoked_at DateTime?

  created_at DateTime @default(now())

  user users @relation(fields: [user_id], references: [id])

  @@index([user_id])
}

model password_resets {
  id BigInt @id @default(autoincrement())

  user_id BigInt

  token      String    @unique
  expired_at DateTime
  used_at    DateTime?

  created_at DateTime @default(now())

  user users @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([token])
}

model email_verifications {
  id BigInt @id @default(autoincrement())

  user_id BigInt

  token       String    @unique
  expired_at  DateTime
  verified_at DateTime?

  created_at DateTime @default(now())

  user users @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([token])
}

// 
// ORGANIZER
// 
model organizers {
  id        BigInt @id @default(autoincrement())
  public_id String @unique @default(uuid())

  user_id BigInt

  company_name String
  slug         String  @unique
  logo         String?

  email       String?
  phone       String?
  website     String?
  description String?
  address     String?

  status      OrganizerStatus @default(pending)
  verified_at DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  owner  users    @relation(fields: [user_id], references: [id])
  events events[]

  @@index([status])
}

// 
// EVENT
// 
model event_categories {
  id        BigInt @id @default(autoincrement())
  public_id String @unique @default(uuid())

  name String
  slug String @unique

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  events events[]
}

model venues {
  id        BigInt @id @default(autoincrement())
  public_id String @unique @default(uuid())

  city_id BigInt

  name  String
  slug  String  @unique
  image String?

  address String?

  latitude  Decimal?
  longitude Decimal?

  google_maps_url String?

  capacity  Int?
  is_active Boolean @default(true)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  city   cities   @relation(fields: [city_id], references: [id])
  events events[]

  @@index([city_id])
}

model events {
  id        BigInt @id @default(autoincrement())
  public_id String @unique @default(uuid())

  organizer_id BigInt
  category_id  BigInt
  venue_id     BigInt

  title       String
  slug        String  @unique
  summary     String?
  description String?

  banner    String?
  thumbnail String?
  poster    String?

  minimum_age Int?
  dress_code  String?

  gate_open_at   DateTime?
  start_at       DateTime
  end_at         DateTime
  sales_start_at DateTime?
  sales_end_at   DateTime?

  status          EventStatus @default(draft)
  approved_by     BigInt?
  approved_at     DateTime?
  rejected_reason String?

  is_featured  Boolean @default(false)
  is_published Boolean @default(false)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  organizer      organizers              @relation(fields: [organizer_id], references: [id])
  category       event_categories        @relation(fields: [category_id], references: [id])
  venue          venues                  @relation(fields: [venue_id], references: [id])
  approvedBy     users?                  @relation("approvedBy", fields: [approved_by], references: [id])
  images         event_images[]
  information    event_information[]
  terms          event_terms[]
  faqs           event_faqs[]
  schedules      event_schedules[]
  contacts       event_contacts[]
  socials        event_socials[]
  sponsors       event_sponsors[]
  checkinDevices event_checkin_devices[]
  eventTags      event_tags[]
  ticketTypes    ticket_types[]

  @@index([organizer_id])
  @@index([category_id])
  @@index([venue_id])
  @@index([approved_by])
  @@index([status])
  @@index([start_at, end_at])
}

model event_images {
  id BigInt @id @default(autoincrement())

  event_id BigInt

  image_url  String
  alt_text   String?
  sort_order Int     @default(0)

  created_at DateTime @default(now())

  event events @relation(fields: [event_id], references: [id])

  @@index([event_id])
}

model event_information {
  id BigInt @id @default(autoincrement())

  event_id BigInt

  title      String
  content    String
  sort_order Int    @default(0)

  created_at DateTime @default(now())

  event events @relation(fields: [event_id], references: [id])

  @@index([event_id])
}

model event_terms {
  id BigInt @id @default(autoincrement())

  event_id BigInt

  title      String
  content    String
  sort_order Int    @default(0)

  created_at DateTime @default(now())

  event events @relation(fields: [event_id], references: [id])

  @@index([event_id])
}

model event_faqs {
  id BigInt @id @default(autoincrement())

  event_id BigInt

  question   String
  answer     String
  sort_order Int    @default(0)

  created_at DateTime @default(now())

  event events @relation(fields: [event_id], references: [id])

  @@index([event_id])
}

model event_schedules {
  id BigInt @id @default(autoincrement())

  event_id BigInt

  title       String
  description String?
  start_at    DateTime?
  end_at      DateTime?
  sort_order  Int       @default(0)

  created_at DateTime @default(now())

  event events @relation(fields: [event_id], references: [id])

  @@index([event_id])
}

model event_contacts {
  id BigInt @id @default(autoincrement())

  event_id BigInt

  contact_name String?
  phone        String?
  email        String?

  created_at DateTime @default(now())

  event events @relation(fields: [event_id], references: [id])

  @@index([event_id])
}

model event_socials {
  id BigInt @id @default(autoincrement())

  event_id BigInt

  platform String // instagram, twitter, tiktok, website
  url      String

  created_at DateTime @default(now())

  event events @relation(fields: [event_id], references: [id])

  @@index([event_id])
}

model event_sponsors {
  id        BigInt @id @default(autoincrement())
  public_id String @unique @default(uuid())

  event_id BigInt

  name    String
  logo    String?
  website String?

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  event events @relation(fields: [event_id], references: [id])

  @@index([event_id])
}

model event_checkin_devices {
  id        BigInt @id @default(autoincrement())
  public_id String @unique @default(uuid())

  event_id BigInt

  name           String?
  device_code    String    @unique
  status         String    @default("active") // active, inactive
  last_active_at DateTime?

  created_at DateTime @default(now())

  event events @relation(fields: [event_id], references: [id])

  @@index([event_id])
}

model tags {
  id        BigInt @id @default(autoincrement())
  public_id String @unique @default(uuid())

  name String @unique
  slug String @unique

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  eventTags event_tags[]
}

model event_tags {
  id BigInt @id @default(autoincrement())

  event_id BigInt
  tag_id   BigInt

  created_at DateTime @default(now())

  event events @relation(fields: [event_id], references: [id])
  tag   tags   @relation(fields: [tag_id], references: [id])

  @@unique([event_id, tag_id])
}

// 
// TICKETING
// 
model ticket_types {
  id        BigInt @id @default(autoincrement())
  public_id String @unique @default(uuid())

  event_id BigInt

  name        String
  description String?

  price        Decimal @db.Decimal(12, 2)
  quota        Int
  sold         Int     @default(0)
  max_purchase Int     @default(5)

  sale_start_at DateTime?
  sale_end_at   DateTime?

  status TicketTypeStatus @default(active)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  event      events        @relation(fields: [event_id], references: [id])
  cartItems  cart_items[]
  orderItems order_items[]

  @@index([event_id])
  @@index([status])
}

// 
// CART & ORDER
// 
model carts {
  id        BigInt @id @default(autoincrement())
  public_id String @unique @default(uuid())

  user_id BigInt @unique

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  user  users        @relation(fields: [user_id], references: [id])
  items cart_items[]
}

model cart_items {
  id BigInt @id @default(autoincrement())

  cart_id        BigInt
  ticket_type_id BigInt

  quantity   Int
  unit_price Decimal @db.Decimal(12, 2)
  subtotal   Decimal @db.Decimal(12, 2)

  created_at DateTime @default(now())

  cart       carts        @relation(fields: [cart_id], references: [id])
  ticketType ticket_types @relation(fields: [ticket_type_id], references: [id])

  @@index([cart_id])
  @@index([ticket_type_id])
}

model orders {
  id        BigInt @id @default(autoincrement())
  public_id String @unique @default(uuid())

  user_id BigInt

  order_number String @unique

  subtotal    Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  service_fee Decimal @default(0) @db.Decimal(12, 2)
  tax         Decimal @default(0) @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  status     OrderStatus @default(pending)
  expired_at DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  user          users            @relation(fields: [user_id], references: [id])
  orderItems    order_items[]
  voucherUsages voucher_usages[]
  payments      payments[]

  @@index([user_id])
  @@index([status])
}

model order_items {
  id BigInt @id @default(autoincrement())

  order_id       BigInt
  ticket_type_id BigInt

  quantity Int
  price    Decimal @db.Decimal(12, 2)
  subtotal Decimal @db.Decimal(12, 2)

  created_at DateTime @default(now())

  order      orders       @relation(fields: [order_id], references: [id])
  ticketType ticket_types @relation(fields: [ticket_type_id], references: [id])
  tickets    tickets[]

  @@index([order_id])
  @@index([ticket_type_id])
}

model vouchers {
  id        BigInt @id @default(autoincrement())
  public_id String @unique @default(uuid())

  code String @unique

  discount_type  DiscountType
  discount_value Decimal      @db.Decimal(12, 2)
  max_discount   Decimal?     @db.Decimal(12, 2)
  quota          Int?

  start_at DateTime?
  end_at   DateTime?

  is_active Boolean @default(true)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  voucherUsages voucher_usages[]
}

model voucher_usages {
  id BigInt @id @default(autoincrement())

  voucher_id BigInt
  user_id    BigInt
  order_id   BigInt @unique

  created_at DateTime @default(now())

  voucher vouchers @relation(fields: [voucher_id], references: [id])
  user    users    @relation(fields: [user_id], references: [id])
  order   orders   @relation(fields: [order_id], references: [id])

  @@index([voucher_id])
  @@index([user_id])
}

// 
// PAYMENT
// 
model payments {
  id        BigInt @id @default(autoincrement())
  public_id String @unique @default(uuid())

  order_id BigInt

  payment_method String?
  provider       String?
  transaction_id String?

  gross_amount Decimal       @db.Decimal(12, 2)
  status       PaymentStatus @default(pending)

  paid_at DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  order orders         @relation(fields: [order_id], references: [id])
  logs  payment_logs[]

  @@index([order_id])
  @@index([status])
}

model payment_logs {
  id BigInt @id @default(autoincrement())

  payment_id BigInt

  payload  Json?
  response Json?

  created_at DateTime @default(now())

  payment payments @relation(fields: [payment_id], references: [id])

  @@index([payment_id])
}

// 
// TICKET (ISSUED) & CHECK-IN
// 
model tickets {
  id        BigInt @id @default(autoincrement())
  public_id String @unique @default(uuid())

  order_item_id BigInt
  owner_id      BigInt

  ticket_code String @unique
  qr_token    String @unique

  attendee_name  String?
  attendee_email String?
  attendee_phone String?

  status        TicketStatus @default(issued)
  checked_in_at DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  orderItem order_items    @relation(fields: [order_item_id], references: [id])
  owner     users          @relation(fields: [owner_id], references: [id])
  scans     ticket_scans[]

  @@index([order_item_id])
  @@index([owner_id])
  @@index([status])
}

model ticket_scans {
  id BigInt @id @default(autoincrement())

  ticket_id  BigInt
  scanned_by BigInt

  gate        String?
  device      String?
  scan_result ScanResult

  scanned_at DateTime @default(now())

  ticket  tickets @relation(fields: [ticket_id], references: [id])
  scanner users   @relation(fields: [scanned_by], references: [id])

  @@index([ticket_id])
  @@index([scanned_by])
}

// 
// SYSTEM & SUPPORT
// 
model notifications {
  id        BigInt @id @default(autoincrement())
  public_id String @unique @default(uuid())

  user_id BigInt

  title   String
  message String?
  type    NotificationType?

  reference_type String?
  reference_id   BigInt?

  is_read Boolean   @default(false)
  read_at DateTime?

  created_at DateTime @default(now())

  user users @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([is_read])
}

model banners {
  id        BigInt @id @default(autoincrement())
  public_id String @unique @default(uuid())

  title String?
  image String
  url   String?

  is_active  Boolean @default(true)
  sort_order Int     @default(0)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
}

model audit_logs {
  id BigInt @id @default(autoincrement())

  user_id BigInt?

  action     AuditAction
  table_name String
  record_id  BigInt?

  old_data Json?
  new_data Json?

  ip_address String?
  user_agent String?

  created_at DateTime @default(now())

  user users? @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([table_name, record_id])
}

model activity_logs {
  id BigInt @id @default(autoincrement())

  user_id BigInt?

  activity       String
  reference_type String?
  reference_id   BigInt?

  created_at DateTime @default(now())

  user users? @relation(fields: [user_id], references: [id])

  @@index([user_id])
}
